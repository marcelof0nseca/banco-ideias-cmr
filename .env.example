# =============================================================================
# Banco de Ideias Legislativas - CMR
# Copie para .env e preencha. NUNCA versione o .env (contem segredos).
#   cp .env.example .env
# =============================================================================

# -----------------------------------------------------------------------------
# BANCO DE DADOS
# -----------------------------------------------------------------------------
# Local com PostgreSQL instalado na maquina:
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/banco_ideias?schema=public"
# Local com Docker (docker compose up -d):
# DATABASE_URL="postgresql://bancoideias:senhalocal@localhost:5433/banco_ideias?schema=public"

# -----------------------------------------------------------------------------
# CRIPTOGRAFIA DO CPF/CNPJ  (especificacao, secao 8.3)
# -----------------------------------------------------------------------------
# Chave AES-256-GCM: 32 bytes em base64. Gere com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
DOCUMENTO_CHAVE=""

# Pepper do hash SHA-256 de busca. Sem ele, um dump do banco permite
# enumerar CPFs por forca bruta. Gere com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
DOCUMENTO_PEPPER=""

# -----------------------------------------------------------------------------
# INTEGRACAO COM O PORTAL DA CAMARA  (especificacao, secao 12)
# -----------------------------------------------------------------------------
# Vazio  = subdominio (bancodeideias.recife.pe.leg.br)  <- recomendado
# Com valor = rota atras do proxy do portal, ex.: /participacao-popular/banco-de-ideias
# A troca entre os dois cenarios NAO deve exigir mudanca de codigo.
NEXT_PUBLIC_BASE_PATH=""

# URL publica completa, usada em canonical, sitemap e Open Graph
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Link de volta ao portal institucional
NEXT_PUBLIC_URL_CAMARA="https://www.recife.pe.leg.br"

# -----------------------------------------------------------------------------
# PRAZOS E LIMITES  (parametrizaveis, secao 3.3 e 8.5)
# -----------------------------------------------------------------------------
TRIAGEM_SLA_DIAS_UTEIS="15"
LIMITE_CADASTRO_POR_IP_HORA="5"
LIMITE_IDEIAS_POR_DOCUMENTO_DIA="3"

# -----------------------------------------------------------------------------
# AUTENTICACAO  (login do painel interno)
# -----------------------------------------------------------------------------
# Segredo que assina o cookie de sessao (JWT HS256). >= 32 bytes. Gere com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=""
