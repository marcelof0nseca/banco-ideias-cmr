# =============================================================================
# Banco de Ideias Legislativas - Camara Municipal do Recife
# Modelo de configuracao. NAO contem nenhum valor real.
#
#   cp .env.example .env
#   chmod 600 .env          (so o dono le: o arquivo guarda segredos)
#
# Depois preencha cada item marcado OBRIGATORIO. O .env NUNCA vai para o Git
# (.gitignore) nem para dentro da imagem Docker (.dockerignore).
#
# Gere cada segredo com o comando indicado ao lado dele (openssl ja vem no
# Linux). Use um valor DIFERENTE para cada segredo e para cada ambiente
# (homologacao e producao).
#
# Formato: NOME=valor, sem espacos em volta do "=". Aspas sao opcionais.
# Guia completo: docs/implantacao/guia-ti.md
# =============================================================================


# -----------------------------------------------------------------------------
# 1. BANCO DE DADOS (PostgreSQL 16, conteiner "db")
# -----------------------------------------------------------------------------

# OBRIGATORIO. Usuario dono do banco. Pode manter este nome.
POSTGRES_USER=bancoideias

# OBRIGATORIO. Senha do banco. Gere com:   openssl rand -hex 24
# Use so letras e numeros (o comando acima ja gera assim): simbolos como
# @ : / # quebram o DATABASE_URL abaixo.
# ATENCAO: o PostgreSQL so le esta senha na PRIMEIRA subida (volume vazio).
# Trocar aqui depois nao muda a senha do banco - veja o guia, "Trocar a senha
# do banco".
POSTGRES_PASSWORD=

# OBRIGATORIO. Endereco que a aplicacao usa para falar com o banco.
# Repita o usuario e a senha acima. "db" e o nome do conteiner do banco na
# rede interna do Docker - nao troque por localhost nem por IP.
DATABASE_URL=postgresql://bancoideias:COLE_A_SENHA_AQUI@db:5432/banco_ideias?schema=public


# -----------------------------------------------------------------------------
# 2. PROTECAO DO CPF/CNPJ DO CIDADAO (LGPD)
# -----------------------------------------------------------------------------
# Os documentos ficam cifrados no banco. SEM estas duas chaves os CPFs ja
# gravados ficam ILEGIVEIS e a busca por titular para de funcionar.
# >>> Guarde copia das duas em local seguro (cofre de senhas da TI), separada
# >>> do backup do banco. Backup do banco sem as chaves nao recupera os CPFs.
# Nunca troque depois que o sistema estiver em uso.

# OBRIGATORIO. Chave de cifra AES-256 (32 bytes em base64). Gere com:
#   openssl rand -base64 32
DOCUMENTO_CHAVE=

# OBRIGATORIO. "Tempero" secreto do resumo usado para achar um CPF sem
# decifra-lo. Gere com:   openssl rand -hex 32
DOCUMENTO_PEPPER=


# -----------------------------------------------------------------------------
# 3. LOGIN DO PAINEL INTERNO (servidores, gabinetes, administrador)
# -----------------------------------------------------------------------------

# OBRIGATORIO. Segredo que assina o cookie de sessao. Gere com:
#   openssl rand -hex 32
# Pode ser trocado a qualquer momento: o unico efeito e que todos precisam
# entrar de novo.
AUTH_SECRET=


# -----------------------------------------------------------------------------
# 4. ENDERECO PUBLICO DO SITE
# -----------------------------------------------------------------------------
# Estas tres entram na IMAGEM no momento do "docker compose build" (o
# navegador do cidadao recebe esses valores). Mudou alguma? Rode de novo:
#   docker compose build && docker compose up -d app

# URL publica completa, sem barra no final. Usada em links de
# compartilhamento, mapa do site e buscadores.
NEXT_PUBLIC_SITE_URL=https://bancodeideias.recife.pe.leg.br

# Como o site e publicado (especificacao, secao 12):
#   vazio                                    -> subdominio proprio (recomendado)
#   /participacao-popular/banco-de-ideias    -> pasta dentro do portal da Camara
# Use junto com o modelo certo de Nginx: nginx/subdominio.conf ou
# nginx/proxy-portal.conf.
NEXT_PUBLIC_BASE_PATH=

# Link "voltar ao portal" no cabecalho e no rodape.
NEXT_PUBLIC_URL_CAMARA=https://www.recife.pe.leg.br


# -----------------------------------------------------------------------------
# 5. PRAZOS E LIMITES (opcionais - sem valor, vale o padrao indicado)
# -----------------------------------------------------------------------------
# Lidos quando a aplicacao liga. Mudou? docker compose up -d app

# Prazo da triagem, em dias uteis (seg a sex). Padrao: 15.
TRIAGEM_SLA_DIAS_UTEIS=15

# Quantas ideias um mesmo endereco IP pode enviar por hora. Padrao: 5.
# Se muitas pessoas usam a mesma rede (ex.: evento na Camara), aumente.
LIMITE_CADASTRO_POR_IP_HORA=5

# Quantas ideias um mesmo CPF/CNPJ pode enviar por dia. Padrao: 3.
LIMITE_IDEIAS_POR_DOCUMENTO_DIA=3


# =============================================================================
# DESENVOLVIMENTO (so na maquina do desenvolvedor - ignore em producao)
# Com "docker compose -f docker-compose.dev.yml up -d" e "npm run dev", troque:
#   DATABASE_URL=postgresql://bancoideias:senhalocal@localhost:5433/banco_ideias?schema=public
#   NEXT_PUBLIC_SITE_URL=http://localhost:3000
# e gere os segredos das secoes 2 e 3 do mesmo jeito.
# =============================================================================
